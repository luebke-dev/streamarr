# pyrate.media backup configuration (example)
#
# Copy to `backup.env` next to backup.sh and adjust. backup.sh / restore.sh
# auto-source `deployment/backup/backup.env` if it exists, or the file passed
# as the first CLI argument, or $BACKUP_ENV_FILE.
#
# Any value already present in the environment wins over this file, and the
# repo-root `.env` is sourced for POSTGRES_* if those are still unset.

# --- Where backups are written locally ---------------------------------------
# Timestamped sub-archives are created under here.
BACKUP_ROOT=/var/backups/pyrate

# Delete local backup sets older than this many days (0 = keep everything).
RETENTION_DAYS=14

# --- PostgreSQL --------------------------------------------------------------
# Preferred path: run pg_dump inside the running Postgres container (the client
# tools are only guaranteed to exist there, not in the backend image).
# Set PG_CONTAINER to "" to instead use a local pg_dump against PGHOST.
PG_CONTAINER=pyratemedia-db-1
POSTGRES_USER=pyrate
POSTGRES_DB=pyrate
# POSTGRES_PASSWORD is read from the environment / repo-root .env.

# Direct (local pg_dump) mode — only used when PG_CONTAINER is empty.
PGHOST=127.0.0.1
PGPORT=5432

# --- Elasticsearch -----------------------------------------------------------
ES_HOST=127.0.0.1
ES_PORT=9200
# Name of a registered ES snapshot repository. Leave empty to SKIP the ES
# snapshot entirely — the search index is fully rebuildable from Postgres via
# the admin reindex endpoints, so it is safe to omit from backups.
ES_SNAPSHOT_REPO=
# If set together with ES_SNAPSHOT_REPO, backup.sh will register a filesystem
# repository at this path first (must be inside the ES `path.repo` allowlist).
ES_SNAPSHOT_REPO_LOCATION=

# --- Media / config files (optional) -----------------------------------------
# Media libraries are usually far too large for per-run archives; leave this 0
# and back media up with a dedicated file-level tool (rsync/rclone/restic).
BACKUP_INCLUDE_MEDIA=0
# Space-separated list of directories to tar when BACKUP_INCLUDE_MEDIA=1.
MEDIA_DIRS="./data/library"
# Space-separated list of config files/dirs always included (small, important).
CONFIG_PATHS=".env docker-compose.yml deployment"

# --- Off-site upload (optional) ----------------------------------------------
# rclone remote+path, e.g. "s3:my-bucket/pyrate-backups". Requires `rclone`.
RCLONE_REMOTE=
# OR an S3 URI, e.g. "s3://my-bucket/pyrate-backups". Requires `aws` CLI.
AWS_S3_TARGET=
