[Unit]
Description=Streamarr Task Scheduler (TaskIQ)
After=streamarr-postgres.service streamarr-redis.service streamarr-migrate.service
# Block startup until DB migrations have completed successfully.
Requires=streamarr-migrate.service

[Container]
Image=registry.gitlab.com/streamarr.media/backend:latest
ContainerName=streamarr-scheduler

# Secrets & host paths (POSTGRES_PASSWORD, SECRET_KEY, DATA_DIR,
# PROJECT_ROOT, ...) are injected from this file. Create it with mode 0600,
# owned by root. See deployment/README.md.
EnvironmentFile=/etc/streamarr/streamarr.env

Exec=uv run taskiq scheduler streamarr.worker:scheduler

Environment=DATABASE_URL=postgresql+asyncpg://streamarr:${POSTGRES_PASSWORD}@streamarr-postgres:5432/streamarr
Environment=REDIS_URL=redis://streamarr-redis:6379/0
Environment=ELASTICSEARCH_HOST=streamarr-elasticsearch
Environment=ELASTICSEARCH_PORT=9200
Environment=SECRET_KEY=${SECRET_KEY}
Environment=PROJECT_ROOT=${PROJECT_ROOT}

[Service]
Restart=unless-stopped
TimeoutStartSec=60

[Install]
WantedBy=default.target
