[Unit]
Description=Streamarr Frontend (Quasar SPA)

[Container]
Image=registry.gitlab.com/streamarr.media/frontend:latest
ContainerName=streamarr-frontend

# Attach to the shared network so the other units resolve this one by name.
Network=streamarr.network

PublishPort=3000:3000

[Service]
Restart=unless-stopped
TimeoutStartSec=30

[Install]
WantedBy=default.target