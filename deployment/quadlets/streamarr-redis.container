[Unit]
Description=Streamarr Redis Cache

[Container]
Image=docker.io/library/redis:7-alpine
ContainerName=streamarr-redis

# Attach to the shared network so the other units resolve this one by name.
Network=streamarr.network

# Secrets & host paths (POSTGRES_PASSWORD, SECRET_KEY, DATA_DIR,
# PROJECT_ROOT, ...) are injected from this file. Create it with mode 0600,
# owned by root. See deployment/README.md.
EnvironmentFile=/etc/streamarr/streamarr.env

Volume=${DATA_DIR}/redis:/data:rw,z

[Service]
Restart=unless-stopped
TimeoutStartSec=30

[Install]
WantedBy=default.target