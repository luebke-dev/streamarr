# =============================================================================
# streamarr.media – Docker Compose environment variables
# Copy this file to .env and adjust all values before starting the stack.
# =============================================================================


# -----------------------------------------------------------------------------
# Image registry & tag
# -----------------------------------------------------------------------------
REGISTRY=registry.gitlab.com/streamarr.media
IMAGE_TAG=latest


# -----------------------------------------------------------------------------
# PostgreSQL
# Used by the `db` service and referenced in DATABASE_URL.
# -----------------------------------------------------------------------------
POSTGRES_USER=streamarr
POSTGRES_PASSWORD=changeme          # CHANGE THIS
POSTGRES_DB=streamarr
# Optional: expose Postgres on the host (default: 5432)
# POSTGRES_PORT=5432


# -----------------------------------------------------------------------------
# Backend
# DATABASE_URL / REDIS_URL are composed automatically in docker-compose.yml
# from the variables above; override here only if you use an external DB/Redis.
# -----------------------------------------------------------------------------
SECRET_KEY=change-this-to-a-long-random-string   # CHANGE THIS  (openssl rand -hex 32)
# Public URL for browser redirects, invite links, email links, and OIDC
# callback handoff back to the web app. Use the canonical HTTPS origin in prod.
APP_URL=https://streamarr.example.com
# OIDC provider settings are managed in Admin -> Settings -> OIDC. Register
# this redirect URI at the provider: https://streamarr.example.com/api/auth/callback
# Shared secret used to authenticate the backend's lightrays webhook calls.
# REQUIRED. Generate with: openssl rand -hex 32
LIGHTRAYS_JWT_SECRET=change-this-to-a-long-random-string
# Shared secret used by all downloader microservices (spotdl/torrent/usenet)
# when calling back into /api/webhooks/*. When unset the backend logs a
# warning and accepts unauthenticated callbacks (dev/legacy). Set in prod.
# Generate with: openssl rand -hex 32
DOWNLOADER_WEBHOOK_SECRET=
# IMPORTANT: Absolute HOST path to the streamarr.media installation directory.
# This is used by the worker to create Docker volume mounts for FFmpeg
# transcoding containers (Docker-in-Docker). Must be a host path, not a
# container path. Example: /srv/streamarr or /home/user/streamarr.media
PROJECT_ROOT=/srv/streamarr
# Set to true to enable hardware-accelerated transcoding (requires GPU pass-through)
ENABLE_HARDWARE_ACCEL=false
# Number of uvicorn workers for the API process
BACKEND_WORKERS=2
# Optional: expose the API on a different host port (default: 8000)
# BACKEND_PORT=8000


# -----------------------------------------------------------------------------
# Worker replicas (TaskIQ)
# -----------------------------------------------------------------------------
WORKER_REPLICAS=2


# -----------------------------------------------------------------------------
# Redis (internal only by default – no port exposed)
# Override only when using an external Redis instance:
# REDIS_URL=redis://:password@external-host:6379/0
# REDIS_PORT=6379
# -----------------------------------------------------------------------------


# -----------------------------------------------------------------------------
# Elasticsearch
# -----------------------------------------------------------------------------
ELASTICSEARCH_HOST=elasticsearch
ELASTICSEARCH_PORT=9200
ELASTICSEARCH_INDEX_PREFIX=streamarr
ELASTICSEARCH_USE_SSL=false
ELASTICSEARCH_VERIFY_CERTS=false
# Elasticsearch image tag. Must be a 9.x line: the Python client is pinned to
# elasticsearch>=9.2.0 and refuses the version handshake against an 8.x server.
ES_IMAGE_TAG=9.2.0
# JVM heap size in MiB (same value used for Xms and Xmx)
ES_HEAP_SIZE=512
# Optional: expose ES on the host (default: 9200)
# ES_PORT=9200


# -----------------------------------------------------------------------------
# Lightrays (WebRTC / streaming relay)
# LIGHTRAYS_HOSTNAME should be the publicly reachable hostname or IP of the
# machine running this stack (used for WebRTC ICE candidates).
# -----------------------------------------------------------------------------
LIGHTRAYS_HOSTNAME=lightrays.example.com
# Absolute host paths for Docker-in-Docker bind mounts (must NOT be relative)
LIGHTRAYS_HOST_XDG_RUNTIME_DIR=/srv/streamarr/lightrays/runtime
LIGHTRAYS_HOST_STATE_DIR=/srv/streamarr/lightrays/state
LIGHTRAYS_STUN_SERVER=stun://stun.l.google.com:19302
# Allowed CORS origins, comma-separated. Use * to allow all origins.
# Example: https://streamarr.example.com,https://admin.example.com
LIGHTRAYS_CORS_ORIGINS=*
# Optional: TURN relay (required for clients behind symmetric NAT)
LIGHTRAYS_TURN_SERVER=
LIGHTRAYS_TURN_USERNAME=
LIGHTRAYS_TURN_PASSWORD=
# Browser-reachable Lightrays API/WebSocket base URL. Leave empty only when an
# external proxy serves /api/lightrays-ws from the same origin as the frontend.
LIGHTRAYS_PUBLIC_URL=https://lightrays.example.com
# Server-side allowlisted runtime profile and image used for game launches.
LIGHTRAYS_DEFAULT_RUNTIME_PROFILE=gow-steam
LIGHTRAYS_GOW_IMAGE=ghcr.io/games-on-whales/steam:edge
LIGHTRAYS_RECONNECT_GRACE_SECS=30
LIGHTRAYS_WS_TICKET_TTL_SECS=120
# Idle-based session timeout. Lightrays drops sessions idle longer than
# this; Streamarr's Redis bookkeeping uses the same value (+60s grace) so
# both sides age out together.
LIGHTRAYS_SESSION_TIMEOUT_SECS=3600
# Optional: change the host/container port lightrays listens on (default: 8009)
# LIGHTRAYS_PORT=8009


# -----------------------------------------------------------------------------
# Frontend
# Optional: expose the frontend on a different host port (default: 3000)
# FRONTEND_PORT=3000
# -----------------------------------------------------------------------------


# -----------------------------------------------------------------------------
# SABnzbd (legacy Usenet downloader)
# PUID/PGID should match the user that owns the data directories.
# Optional: expose SABnzbd on a different host port (default: 8080)
# SABNZBD_PORT=8080
# -----------------------------------------------------------------------------
PUID=1000
PGID=1000


# -----------------------------------------------------------------------------
# Spotify downloader (spotify-downloader)
# Downloads Spotify tracks as OGG via librespot.
# Optional: expose on a different host port (default: 3001)
# SPOTDL_PORT=3001
# SPOTDL_OAUTH_PORT=8898
# -----------------------------------------------------------------------------


# -----------------------------------------------------------------------------
# Torrent downloader (torrent-downloader)
# Downloads from magnet links and .torrent files.
# Optional: expose on a different host port (default: 3002)
# TORRENT_DL_PORT=3002
# TORRENT_DHT_PORT=6881
# -----------------------------------------------------------------------------


# -----------------------------------------------------------------------------
# Usenet downloader (usenet-downloader)
# Downloads from Usenet newsgroups via NZB files.
# Requires a Usenet provider account.
# Optional: expose on a different host port (default: 3003)
# USENET_DL_PORT=3003
# -----------------------------------------------------------------------------
USENET_HOST=                              # e.g. news.example.com
USENET_PORT=563
USENET_USERNAME=
USENET_PASSWORD=
USENET_TLS=true
USENET_CONNECTIONS=100


# -----------------------------------------------------------------------------
# Data directory  (mounted into all containers that need file access)
# Use an absolute path in production, e.g. /srv/streamarr
# -----------------------------------------------------------------------------
DATA_DIR=./data
