# Server
SERVER_HOST=0.0.0.0
SERVER_PORT=3000

# Database
DATABASE_PATH=/data/torrent-downloader.db

# Downloads
DOWNLOAD_DIR=/downloads
MAX_CONCURRENT_DOWNLOADS=5

# Torrent
ENABLE_DHT=true
LISTEN_PORT=6881
SEED_RATIO=0.0

# Webhooks (optional)
# WEBHOOK_URL=http://backend:8000/api/v1/webhooks/torrent
# WEBHOOK_TIMEOUT_SECS=10
# WEBHOOK_MAX_RETRIES=3

# Logging
RUST_LOG=torrent_downloader=info,tower_http=info
