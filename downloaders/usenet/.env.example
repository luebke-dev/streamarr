# Server
SERVER_HOST=0.0.0.0
SERVER_PORT=3000

# Database
DATABASE_PATH=/data/usenet.db

# Downloads
DOWNLOAD_DIR=/downloads
DOWNLOAD_TEMP_DIR=/downloads/.tmp
DOWNLOAD_MAX_CONCURRENT_JOBS=3
# Peak decoded-segment RAM budget (MiB). Fetching blocks once this much
# undelivered data is buffered, so memory stays bounded regardless of release
# size. Default 500.
ARTICLE_CACHE_MB=500
# Global download speed cap in KiB/s (0 = unlimited). Also settable at
# runtime via POST /api/control/speedlimit.
SPEED_LIMIT_KBPS=0

# Usenet (required)
USENET_HOST=news.example.com
USENET_PORT=563
USENET_TLS=true
USENET_USERNAME=your_username
USENET_PASSWORD=your_password
USENET_CONNECTIONS=8
# Selection order (lower = tried first) and whether the server may be
# auto-deactivated when many connections go bad. Primary is priority 0 and
# required by default.
USENET_PRIORITY=0
USENET_OPTIONAL=false

# Backup / fill servers (optional). Repeat with _2 ... _5.
# A blocked server is skipped instantly, so a dead primary no longer costs
# the connect timeout on every article.
# BACKUP_SERVER_1_HOST=fill.example.com
# BACKUP_SERVER_1_PORT=563
# BACKUP_SERVER_1_TLS=true
# BACKUP_SERVER_1_USERNAME=your_username
# BACKUP_SERVER_1_PASSWORD=your_password
# BACKUP_SERVER_1_CONNECTIONS=4
# BACKUP_SERVER_1_RETENTION_DAYS=0
# BACKUP_SERVER_1_PRIORITY=1
# BACKUP_SERVER_1_OPTIONAL=true

# Webhooks (optional)
# WEBHOOK_URL=http://backend:8000/api/v1/webhooks/usenet
# WEBHOOK_TIMEOUT_SECS=10
# WEBHOOK_MAX_RETRIES=3

# Logging
RUST_LOG=usenet_downloader=info,tower_http=info
