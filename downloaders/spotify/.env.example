# Server
SERVER_HOST=0.0.0.0
SERVER_PORT=3000

# Database
DATABASE_PATH=/data/spotify.db

# Downloads
DOWNLOAD_DIR=/data/downloads

# Spotify
CONFIG_DIR=/data/config
BITRATE=320
# ENABLE_WEBUI=1

# Webhooks (optional)
